# Copia este archivo a .env y completa los valores. NUNCA subas .env ni secrets/ a un repositorio.
# Los valores que empiezan por TU_ se tratan como "sin configurar".

# Ruta a la clave JSON de la cuenta de servicio de Google (relativa a la raíz del workspace o absoluta).
# El spreadsheet de cada campaña debe estar compartido con el client_email de esa cuenta (rol Editor).
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/google_service_account.json

# Snov.io (API v2) - búsqueda y verificación de emails
SNOV_CLIENT_ID=TU_SNOV_CLIENT_ID
SNOV_CLIENT_SECRET=TU_SNOV_CLIENT_SECRET

# Apify - scraper de perfiles de LinkedIn
APIFY_TOKEN=TU_APIFY_TOKEN

# Clay - webhook de la tabla (solo si enrichment.clay_enabled = true en la campaña)
CLAY_WEBHOOK_URL=TU_CLAY_WEBHOOK_URL
CLAY_WEBHOOK_TOKEN=
